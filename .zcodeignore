/target
.env
/data
.DS_Store
.commandcode/

# JS deps only — dist must stay tracked: rust-embed honors .gitignore when
# embedding frontend/dist into the release binary, so ignoring it here would
# ship an EMPTY asset set (found the hard way, ticket 15).
crates/webapp/frontend/node_modules/

# local firebase envs (real values live here, never committed)
crates/webapp/frontend/.env.local

# DOM-smoke build output
crates/webapp/frontend/dist-smoke/

# effort notes / scratch
.scratch/
gui-test-screenshots/

# local before/after comparison runs (carry credential copies in .env)
.compare/
crates/webapp/fixtures/holdings/

