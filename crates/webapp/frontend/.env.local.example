# Firebase web config — public values by design (security is enforced
# server-side by Bearer verification, spec §3.1/t06). Fill from:
# Firebase console → Project settings → General → Your apps → SDK setup.
#
# Backend also needs the project id: set FIREBASE_PROJECT_ID in the repo-root
# .env (or pass --firebase-project-id <id>).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<PROJECT_ID>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
